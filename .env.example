APP_NAME=Storefront Operations API
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:19080,http://127.0.0.1:19080
CORS_ALLOW_CREDENTIALS=false
PUBLIC_ASSET_BASE_URL=http://localhost:19000

# Replace before exposing the backend to any network.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-16-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

POSTGRES_DB=storefront
POSTGRES_USER=storefront
POSTGRES_PASSWORD=storefront_dev_password
DATABASE_URL=postgresql+asyncpg://storefront:storefront_dev_password@postgres:5432/storefront
REDIS_URL=redis://redis:6379/0

# Development only. Configure a real provider before production use.
AUTH_SMS_MOCK=false
WECHAT_PAY_MOCK=true
WECHAT_MCH_ID=
WECHAT_APP_ID=
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
WECHAT_EMPLOYEE_MINI_APP_ID=
WECHAT_EMPLOYEE_MINI_APP_SECRET=
WECHAT_NOTIFY_URL=
WECHAT_REFUND_NOTIFY_URL=

# Optional integrations. All are disabled by default.
PRINT_PROVIDER=disabled
PRINT_GATEWAY_TOKEN=
AI_ADMIN_ENABLED=false
AI_ADMIN_DRY_RUN=true
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
