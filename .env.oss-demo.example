APP_NAME=Storefront Operations Open Source Demo
APP_ENV=demo
APP_DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:19180,http://127.0.0.1:19180
CORS_ALLOW_CREDENTIALS=false
PUBLIC_ASSET_BASE_URL=http://localhost:19100

# Local demo only. Replace these values before exposing the service to a network.
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
EMPLOYEE_JWT_EXPIRE_MINUTES=43200

POSTGRES_DB=storefront_demo
POSTGRES_USER=storefront_demo
POSTGRES_PASSWORD=replace-with-a-local-demo-password
DATABASE_URL=postgresql+asyncpg://storefront_demo:replace-with-a-local-demo-password@postgres:5432/storefront_demo
REDIS_URL=redis://redis:6379/0

# Required on first boot. The value never appears in the public example data.
DEMO_ADMIN_USERNAME=demo-admin
DEMO_ADMIN_PASSWORD=replace-with-a-strong-local-demo-password

AUTH_SMS_MOCK=true
WECHAT_PAY_MOCK=true
SCHEDULER_ENABLED=false
PRINT_PROVIDER=disabled
AI_ADMIN_ENABLED=false
AI_ADMIN_DRY_RUN=true
